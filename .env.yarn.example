# Template of .env.yarn. Copy it to .env.yarn (git ignores that one) and fill in the values:
#
#   cp .env.yarn.example .env.yarn
#
# Yarn injects the file into the scripts it runs (yarn start, yarn workspace backend start...), so
# the backend reads these variables. The values for the local lab are the ones the infrastructure
# creates: Postgres in infra/postgres/cluster.yaml and Keycloak in infra/keycloak/realm-backstage.json.

# Password of the Postgres role "backstage".
POSTGRES_PASSWORD=

# Secret of the login session. Any long random text: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Secrets of the Keycloak clients "backstage" (sign-in) and "backstage-catalog" (import of users and groups).
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CATALOG_CLIENT_SECRET=

# Optional (uncomment to use):
# Token for the GitHub integration, e.g. the publish:github scaffolder action.
# GITHUB_TOKEN=
# Other settings have a default in app-config.yaml and can be overridden here:
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_USER=
# KEYCLOAK_BASE_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CATALOG_CLIENT_ID=
